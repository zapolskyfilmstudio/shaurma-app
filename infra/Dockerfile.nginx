FROM node:22-alpine AS kitchen-build
WORKDIR /app
ARG VITE_API_URL
ARG VITE_BEARER_TOKEN
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BEARER_TOKEN=$VITE_BEARER_TOKEN
COPY kitchen/package*.json ./
RUN npm ci
COPY kitchen/ ./
RUN npm run build

FROM node:22-alpine AS client-build
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=kitchen-build /app/dist /usr/share/nginx/html
COPY --from=client-build /app/dist /usr/share/nginx/client
